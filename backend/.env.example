# Database PostgreSQL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
# Contoh tanpa password (macOS default Homebrew):
DATABASE_URL="postgresql://your_username@localhost:5432/food_ordering"
# Contoh dengan password:
# DATABASE_URL="postgresql://postgres:your_password@localhost:5432/food_ordering"

# JWT Secret Key (gunakan string random yang kuat)
JWT_SECRET="your-secret-key-here"
